# ============================================
# Шаблон конфигурации для сборки (попадает в установщик как backend/.env)
# ============================================
# Здесь НЕТ секретов. Ключ шифрования приложение создаёт само при первом
# запуске и хранит в <userData>\encryption.key, VAPID-ключи не входят в релиз.

# Настройки сервера
CHAT_APP_HOST=0.0.0.0
CHAT_APP_PORT=3001
HTTPS_PORT=3002
CHAT_APP_SERVER_URL=https://192.168.210.48:3002

# HTTPS: требуются сертификаты в ssl/
# В dual-mode HTTP:3001 остаётся активным для десктопа/Android, HTTPS:3002 для iOS/веб.
HTTPS_ENABLED=true
# Принудительный редирект HTTP->HTTPS (отключён, т.к. сломает десктоп/Android):
HTTPS_REDIRECT=false

# === База данных ===
# Установленное приложение работает на своей локальной базе в %APPDATA%
# (путь передаётся из Electron как CHAT_APP_DB_PATH).
CHAT_DB_TYPE=sqlite

# === SQLite PRAGMA (оптимизация производительности) ===
CHAT_SQLITE_CACHE_SIZE=-64000          # 64MB кэш (отрицательное = килобайты)
CHAT_SQLITE_BUSY_TIMEOUT=5000          # ждать при блокировке до 5с (вместо ошибки)
CHAT_SQLITE_MMAP_SIZE=268435456        # 256MB mmap для быстрого чтения
CHAT_SQLITE_TEMP_STORE=2               # 2 = хранить временные таблицы в памяти
CHAT_SQLITE_SYNCHRONOUS=1              # 1 = FULL (безопасно), 2 = NORMAL (быстрее)

# ── ИИ-Агент (локальная модель через Ollama) ──
AI_AGENT_ENABLED=true
AI_AGENT_MAINTENANCE=true # true = отвечает заглушкой "в разработке" вместо вызова Ollama
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
AI_AGENT_NAME=ИИ-Агент
AI_CONTEXT_MESSAGES=10
AI_TIMEOUT_MS=90000