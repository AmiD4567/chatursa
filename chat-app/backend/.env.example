# Ключ шифрования сообщений (обязательно измените!)
CHAT_ENCRYPTION_KEY=your-secret-key-at-least-32-chars

# Настройки сервера (опционально)
CHAT_APP_HOST=0.0.0.0
CHAT_APP_PORT=3001
CHAT_APP_SERVER_URL=http://192.168.1.100:3001

# HTTPS: установите true для включения (требуются сертификаты в ssl/)
HTTPS_ENABLED=false

# VAPID keys для Web Push (сгенерируйте через: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# ── ИИ-Агент (локальная модель через Ollama) ──
AI_AGENT_ENABLED=true
AI_AGENT_MAINTENANCE=true # true = отвечает заглушкой "в разработке" вместо вызова Ollama
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
AI_AGENT_NAME=ИИ-Агент
AI_CONTEXT_MESSAGES=10
AI_TIMEOUT_MS=90000
