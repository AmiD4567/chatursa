{
    "name": "chat-app",
    "version": "1.0.210",
    "description": "РљРѕСЂРїРѕСЂР°С‚РёРІРЅС‹Р№ РјРµСЃСЃРµРЅРґР¶РµСЂ",
    "main": "electron/main.js",
    "scripts": {
        "build": "cd frontend && npm run build",
        "client": "cd frontend && npm start",
        "electron:build": "npm run build && electron-builder --win nsis",
        "electron:build:all": "npm run build && electron-builder --win",
        "electron:dev": "concurrently \"npm run build\" \"wait-on http://localhost:3000 && electron .\"",
        "postinstall": "electron-builder install-app-deps",
        "publish-only": "electron-builder --win nsis --publish always",
        "release": "npm run build && electron-builder --win nsis --publish always",
        "smoke": "node backend/smoke-test.js",
        "server": "cd backend && node server.js",
        "start": "concurrently \"npm run server\" \"npm run client\""
    },
    "build": {
        "appId": "com.pantyuhov.chat",
        "asar": false,
        "directories": {
            "buildResources": "electron",
            "output": "dist"
        },
        "extraFiles": [
            {
                "from": "app-update.yml",
                "to": "resources/app-update.yml"
            }
        ],
        "extraResources": [
            {
                "filter": [
                    "**/*",
                    "!backups/**/*",
                    "!.env",
                    "!*.db",
                    "!*.db-wal",
                    "!*.db-shm",
                    "!*.log",
                    "!node_modules/sqlite3/**/*"
                ],
                "from": "backend",
                "to": "app/backend"
            },
            {
                "from": "backend/.env.dist",
                "to": "app/backend/.env"
            },
            {
                "from": "frontend/build",
                "to": "app/frontend/build"
            }
        ],
        "files": [
            "electron/**/*",
            "backend/**/*",
            "!backend/backups/**/*",
            "!backend/.env",
            "!backend/*.db",
            "!backend/*.db-wal",
            "!backend/*.db-shm",
            "!backend/*.log",
            "!backend/node_modules/sqlite3/**/*",
            "frontend/build/**/*"
        ],
        "msi": {
            "artifactName": "ChatApp-${version}.${ext}",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "oneClick": false,
            "perMachine": false,
            "runAfterFinish": true,
            "shortcutName": "Chat App",
            "upgradeCode": "{8F3B5A7C-9D2E-4F1A-B6C3-5E8D7A9F2B4C}"
        },
        "nsis": {
            "allowToChangeInstallationDirectory": true,
            "artifactName": "ChatApp-Setup-${version}.${ext}",
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "installerHeaderIcon": "electron/icon.ico",
            "installerIcon": "electron/icon.ico",
            "license": "LICENSE",
            "oneClick": false,
            "perMachine": false,
            "runAfterFinish": true,
            "shortcutName": "Chat App",
            "uninstallerIcon": "electron/icon.ico"
        },
        "productName": "ChatApp",
        "publish": {
            "owner": "AmiD4567",
            "private": false,
            "provider": "github",
            "releaseType": "release",
            "repo": "chatursa"
        },
        "win": {
            "icon": "electron/icon.ico",
            "target": [
                "nsis"
            ]
        }
    },
    "dependencies": {
        "electron-updater": "^6.8.3",
        "mssql": "^12.7.0",
        "pg": "^8.22.0"
    },
    "devDependencies": {
        "concurrently": "^8.2.2",
        "electron": "^28.0.0",
        "electron-builder": "^24.9.1",
        "wait-on": "^7.2.0"
    }
}
